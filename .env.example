# GMRITDU Timetable Server Configuration
PORT=3000
NODE_ENV=production

# Cryptographic JWT signing key (generate a strong random secret in production)
JWT_SECRET=CHANGE_ME_STRONG_PRODUCTION_SECRET
JWT_EXPIRES_IN=7d

# Supabase / PostgreSQL connection string
# For Supabase Transaction Pooler (recommended in production): postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# For direct Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Optional overrides:
# DATABASE_SSL=false            # Only disable SSL for local non-TLS Postgres instances
# PG_POOL_MAX=10                # Max concurrent Postgres pool connections
# PG_ENGINE=pglite              # Embedded PostgreSQL test mode (no external Postgres needed)

# CORS allowed origins (comma-separated, leave blank for same-origin only)
CORS_ORIGINS=

# Optional legacy SQLite path used only when running `npm run db:transfer`
SQLITE_PATH=./data/gmritdu_timetable.db
INSTITUTION_NAME=GMR Institute of Technology Deemed to be University

