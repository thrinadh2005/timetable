# ==============================================================================
# GMRIT Deemed to be University - Environment Configuration Template
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

# Server Network & Environment
PORT=3000
NODE_ENV=production

# Cryptographic JWT Signing Key & Token Expiry
JWT_SECRET=gmritdu_production_secret_key_2026_autonomous
JWT_EXPIRES_IN=7d

# Supabase / PostgreSQL Database Connection URL
# If empty, the server automatically defaults to embedded PostgreSQL (PGlite) at ./data/gmritdu-pg
# Supabase Transaction Pooler format:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres
DATABASE_URL=

# Database SSL & Connection Pool Controls
DATABASE_SSL=true
PG_POOL_MAX=10
# Set PG_ENGINE=pglite to force embedded Postgres even if DATABASE_URL is present
# PG_ENGINE=pglite

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins
# Leave empty to allow same-origin requests (bundled Single Page Application)
CORS_ORIGINS=

# Institutional Branding & Metadata
INSTITUTION_NAME=GMR Institute of Technology Deemed to be University
